{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@fixnow/ui": ["./packages/ui/index.ts"],
      "@fixnow/utils": ["./packages/utils/index.ts"],
      "@fixnow/types": ["./packages/types/index.ts"],
      "@fixnow/types/*": ["./packages/types/*"],
      "@fixnow/api": ["./packages/api/index.ts"],
      "@fixnow/api/*": ["./packages/api/*"],
      "@fixnow/hooks": ["./packages/hooks/index.ts"],
      "@fixnow/shared": ["./packages/shared/index.ts"],
      "@fixnow/native": ["./packages/native/index.ts"],
      "@fixnow/native/*": ["./packages/native/*"],
      "@fixnow/assets": ["./packages/assets/index.ts"],
      "@customer/*": ["./apps/customer/*"],
      "@technician/*": ["./apps/technician/*"],
      "@admin/*": ["./apps/admin/*"],
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "apps", "packages"]
}
