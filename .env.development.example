####################################
# FixNow Frontend / Capacitor — DEVELOPMENT
# Copy to `.env` at the repo root.
####################################

####################################
API / REALTIME
####################################
# Web / desktop Vite — localhost is fine when you open http://localhost:5173.
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
#
# Phones/tablets on the same Wi‑Fi:
#   Open Vite via your PC LAN IP (Vite prints Network: http://192.168.x.x:5173).
#   The client automatically rewrites localhost API URLs to that same LAN IP.
#   Do NOT open the site as http://localhost:5173 on the phone.
#
# Capacitor Android:
#   emulator → localhost is rewritten to 10.0.2.2 automatically
#   physical device / packaged WebView → set VITE_DEV_LAN_HOST to your PC LAN IP
# VITE_DEV_LAN_HOST=192.168.1.20
# Or bake the host into the URL instead:
#   VITE_API_URL=http://192.168.1.20:4000/api/v1
# Debug APKs allow cleartext (src/debug network_security_config). Release APKs require HTTPS.

####################################
FIREBASE / FCM (web testing)
####################################
# VITE_FCM_WEB_TOKEN=YOUR_VITE_FCM_WEB_TOKEN
# VITE_FCM_VAPID_KEY=YOUR_VITE_FCM_VAPID_KEY

####################################
GOOGLE IDENTITY
####################################
# VITE_GOOGLE_WEB_CLIENT_ID=YOUR_VITE_GOOGLE_WEB_CLIENT_ID
VITE_GOOGLE_AUTH_BRIDGE_ORIGIN=http://localhost:4000

####################################
GOOGLE MAPS PLATFORM
# VITE_ key = map tiles (TrackingMap). Server key belongs in backend .env:
# GOOGLE_MAPS_SERVER_API_KEY=...
####################################
VITE_GOOGLE_MAPS_API_KEY=YOUR_VITE_GOOGLE_MAPS_API_KEY

####################################
SENTRY
####################################
# VITE_SENTRY_DSN=YOUR_VITE_SENTRY_DSN

####################################
APP DOWNLOAD REMINDER (mobile web only)
# Empty store URLs → "Coming Soon" sheet (no broken links)
####################################
VITE_APP_DOWNLOAD_PROMPT_ENABLED=true
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
VITE_APP_DOWNLOAD_DEEP_LINK=fixnow://
VITE_APP_RELEASE_VERSION=1.0.0

####################################
CAPACITOR live-reload (optional)
####################################
# CAP_SERVER_URL=http://192.168.1.10:5173
