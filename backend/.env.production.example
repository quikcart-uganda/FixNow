####################################
# FixNow Backend — PRODUCTION template
# Copy to the host secret store / `.env` and replace every YOUR_*.
# Never commit filled production values.
####################################

####################################
SERVER
####################################
NODE_ENV=production
APP_ENV=production
PORT=4000
API_PREFIX=/api/v1
APP_NAME=FixNow API
APP_VERSION=1.0.0

####################################
MONGODB
####################################
MONGODB_URI=YOUR_MONGODB_URI

####################################
JWT / SECURITY
####################################
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
COOKIE_SECURE=true
AUTH_COOKIE_ENABLED=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=10
OTP_LENGTH=6
AUTH_EXPOSE_OTP=false

####################################
DEVELOPMENT FEATURE FLAGS
# Production forces every development flag OFF and refuses to boot if one is
# set to true. Admin toggles are read-only in production.
####################################
ENABLE_DEV_OTP=false
ENABLE_DEV_LOGIN=false
ENABLE_TEST_USERS=false
ENABLE_MOCK_PROVIDERS=false
ENABLE_DEBUG_MODE=false
ENABLE_DEVELOPMENT_MODE=false

####################################
CORS / RATE LIMIT
####################################
CORS_ORIGINS=YOUR_PRODUCTION_WEB_ORIGIN,YOUR_CAPACITOR_ORIGIN
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_AUTHENTICATED=2000

####################################
LOCAL UPLOADS
# Fallback disk root when Cloudinary is unavailable.
####################################
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
MEDIA_STORAGE_PROVIDER=cloudinary

####################################
CLOUDINARY
# Official media storage — supply real credentials before go-live media flows.
####################################
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET
CLOUDINARY_FOLDER=fixnow

####################################
EMAIL
####################################
EMAIL_PROVIDER=resend
EMAIL_FROM=FixNow <noreply@YOUR_DOMAIN>
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Or SMTP:
# EMAIL_PROVIDER=smtp
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=FixNow <noreply@YOUR_DOMAIN>
SMTP_REPLY_TO=support@YOUR_DOMAIN
SMTP_SECURE=true
SMTP_IGNORE_TLS=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000

####################################
SMS
####################################
SMS_PROVIDER=console

####################################
FIREBASE / FCM
####################################
PUSH_PROVIDER=fcm
FCM_ENABLED=true
PUSH_RETRY_INTERVAL_MS=60000
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
# FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON

####################################
GOOGLE IDENTITY
####################################
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
PUBLIC_GOOGLE_CLIENT_ID=YOUR_PUBLIC_GOOGLE_CLIENT_ID

####################################
PAYMENTS & ESCROW
####################################
PAYMENT_DEFAULT_PROVIDER=console
PAYMENTS_LIVE=false
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET
ESCROW_AUTO_RELEASE_MS=0

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_MODE=live

FLUTTERWAVE_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_PUBLIC_KEY=YOUR_FLUTTERWAVE_PUBLIC_KEY
FLUTTERWAVE_SECRET_HASH=YOUR_FLUTTERWAVE_SECRET_HASH
FLUTTERWAVE_MODE=live

PESAPAL_CONSUMER_KEY=YOUR_PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_PESAPAL_CONSUMER_SECRET
PESAPAL_IPN_ID=YOUR_PESAPAL_IPN_ID
PESAPAL_ENV=live

MTN_MOMO_SUBSCRIPTION_KEY=YOUR_MTN_MOMO_SUBSCRIPTION_KEY
MTN_MOMO_API_USER=YOUR_MTN_MOMO_API_USER
MTN_MOMO_API_KEY=YOUR_MTN_MOMO_API_KEY
MTN_MOMO_TARGET_ENVIRONMENT=production
MTN_MOMO_CURRENCY=UGX

AIRTEL_MONEY_CLIENT_ID=YOUR_AIRTEL_MONEY_CLIENT_ID
AIRTEL_MONEY_CLIENT_SECRET=YOUR_AIRTEL_MONEY_CLIENT_SECRET
AIRTEL_MONEY_ENV=production
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX

####################################
AI
####################################
AI_ENABLED=false
AI_PROVIDER=console
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gpt-4o-mini
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_GEMINI=gemini-2.0-flash
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000
AI_CONVERSATION_HISTORY_ENABLED=true
AI_HISTORY_LIMIT=12
AI_CUSTOMER_ASSISTANT_ENABLED=true
AI_TECHNICIAN_ASSISTANT_ENABLED=true
AI_ADMIN_ASSISTANT_ENABLED=true
AI_RATE_LIMIT_MAX=60

####################################
DOMAIN WINDOWS
####################################
REVIEW_EDIT_WINDOW_MS=86400000
MESSAGE_EDIT_WINDOW_MS=900000
TRACKING_RETENTION_DAYS=7

####################################
SENTRY
####################################
SENTRY_DSN=YOUR_SENTRY_DSN
