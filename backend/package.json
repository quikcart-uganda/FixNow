{
  "name": "fixnow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FixNow platform API — single backend for Customer, Technician, and Admin",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node ../scripts/run-unit-tests.mjs unit",
    "test:unit": "node ../scripts/run-unit-tests.mjs unit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "node scripts/smoke.mjs --full",
    "test:auth": "node scripts/auth-e2e.mjs",
    "test:payments": "node scripts/payments-e2e.mjs",
    "test:messaging": "node scripts/messaging-e2e.mjs",
    "test:sockets": "node scripts/realtime-e2e.mjs",
    "test:regression": "node scripts/regression.mjs",
    "test:regression:live": "node scripts/regression.mjs --live",
    "ai:eval": "node scripts/ai-eval.mjs",
    "seed:marketing": "tsx scripts/seed-marketing.ts",
    "seed:platform": "tsx scripts/seed-platform.ts",
    "seed:ux": "tsx scripts/seed-ux-content.ts",
    "seed:visual-assets": "tsx scripts/seed-visual-assets.ts",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "seed:admin-catalogue": "tsx scripts/seed-admin-catalogue.ts",
    "migrate:cloudinary": "tsx scripts/migrate-to-cloudinary.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
