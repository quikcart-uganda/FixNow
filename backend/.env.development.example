####################################
# FixNow Backend — DEVELOPMENT template
# Copy to `.env` for local work.
####################################

####################################
SERVER
####################################
NODE_ENV=development
APP_ENV=development
PORT=4000
# Listen on all interfaces so phones on the same Wi‑Fi can reach the API.
# Use HOST=127.0.0.1 only if you intentionally want loopback-only access.
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=FixNow API
APP_VERSION=1.0.0

####################################
MONGODB
####################################
MONGODB_URI=mongodb://127.0.0.1:27017/FixNow

####################################
JWT / SECURITY
####################################
JWT_ACCESS_SECRET=dev-only-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=dev-only-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
COOKIE_SECURE=false
AUTH_COOKIE_ENABLED=false
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=10
OTP_LENGTH=6

####################################
DEVELOPMENT FEATURE FLAGS
# Runtime overrides live in Admin → System Settings → Development Controls.
####################################
ENABLE_DEV_OTP=true
ENABLE_DEV_LOGIN=false
ENABLE_TEST_USERS=false
ENABLE_MOCK_PROVIDERS=false
ENABLE_DEBUG_MODE=true
ENABLE_DEVELOPMENT_MODE=true

####################################
CORS / RATE LIMIT
####################################
# Explicit localhost origins. Non-production also auto-allows private LAN Vite origins
# (http://192.168.x.x:5173 etc.) so phones on the same Wi‑Fi can authenticate.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,https://app.fixnow.local
RATE_LIMIT_WINDOW_MS=900000
# Anonymous budget (no Bearer). Authenticated SPAs use RATE_LIMIT_MAX_AUTHENTICATED.
RATE_LIMIT_MAX=1000
RATE_LIMIT_MAX_AUTHENTICATED=3000

####################################
LOCAL UPLOADS
####################################
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
MEDIA_STORAGE_PROVIDER=cloudinary

####################################
CLOUDINARY
####################################
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET
# CLOUDINARY_FOLDER=fixnow-dev

####################################
EMAIL
####################################
EMAIL_PROVIDER=console
EMAIL_FROM=FixNow <noreply@fixnow.app>
RESEND_API_KEY=YOUR_RESEND_API_KEY
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=FixNow <noreply@fixnow.app>
SMTP_REPLY_TO=
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000

####################################
SMS
####################################
SMS_PROVIDER=console

####################################
FIREBASE / FCM
####################################
PUSH_PROVIDER=console
FCM_ENABLED=false
PUSH_RETRY_INTERVAL_MS=60000
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
# FIREBASE_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON

####################################
GOOGLE IDENTITY
####################################
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
PUBLIC_GOOGLE_CLIENT_ID=YOUR_PUBLIC_GOOGLE_CLIENT_ID

####################################
PAYMENTS & ESCROW
####################################
PAYMENT_DEFAULT_PROVIDER=console
PAYMENTS_LIVE=false
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET
ESCROW_AUTO_RELEASE_MS=0

####################################
AI
####################################
# Enable locally so the floating assistant appears in Customer / Technician / Admin shells.
# Production stays opt-in via .env.production (AI_ENABLED=false by default).
AI_ENABLED=true
AI_PROVIDER=console
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gpt-4o-mini
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_GEMINI=gemini-2.0-flash
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000
AI_CONVERSATION_HISTORY_ENABLED=true
AI_HISTORY_LIMIT=12
AI_CUSTOMER_ASSISTANT_ENABLED=true
AI_TECHNICIAN_ASSISTANT_ENABLED=true
AI_ADMIN_ASSISTANT_ENABLED=true
AI_RATE_LIMIT_MAX=60

####################################
DOMAIN WINDOWS
####################################
REVIEW_EDIT_WINDOW_MS=86400000
MESSAGE_EDIT_WINDOW_MS=900000
TRACKING_RETENTION_DAYS=7

####################################
SENTRY
####################################
SENTRY_DSN=YOUR_SENTRY_DSN

####################################
SCRIPTS / E2E
####################################
API_BASE=http://localhost:4000/api/v1
API_ORIGIN=http://localhost:4000
SOCKET_URL=http://localhost:4000
FIXNOW_API_URL=http://localhost:4000/api/v1
# AI_EVAL_BASE_URL=http://localhost:4000/api/v1
