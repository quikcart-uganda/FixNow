####################################
# FixNow Frontend / Capacitor — environment template
# Copy to `.env` (repo root) and replace YOUR_* placeholders.
# Never commit real secrets.
####################################

####################################
API / REALTIME
####################################
VITE_API_URL=YOUR_VITE_API_URL
VITE_SOCKET_URL=YOUR_VITE_SOCKET_URL
# When VITE_API_URL uses localhost and a phone opens Vite via the PC LAN IP,
# the client rewrites the API host to that same LAN IP automatically.
# Capacitor packaged WebViews still need an explicit LAN host:
# Example: VITE_DEV_LAN_HOST=192.168.1.20
# Emulator default without this is 10.0.2.2.
# VITE_DEV_LAN_HOST=

####################################
FIREBASE / FCM (web testing only)
# Native Android/iOS use android/app/google-services.json (+ APNs).
####################################
VITE_FCM_WEB_TOKEN=YOUR_VITE_FCM_WEB_TOKEN
# Web Push VAPID public key — enables PushManager.subscribe when set
VITE_FCM_VAPID_KEY=YOUR_VITE_FCM_VAPID_KEY

####################################
GOOGLE IDENTITY (GIS)
####################################
VITE_GOOGLE_WEB_CLIENT_ID=YOUR_VITE_GOOGLE_WEB_CLIENT_ID
VITE_GOOGLE_AUTH_BRIDGE_ORIGIN=YOUR_VITE_GOOGLE_AUTH_BRIDGE_ORIGIN

####################################
GOOGLE MAPS PLATFORM (official primary)
# Server key: Geocoding, Places, Directions, Distance Matrix (backend Location Platform)
# Frontend key: map tiles for live tracking (TrackingMap)
####################################
VITE_GOOGLE_MAPS_API_KEY=YOUR_VITE_GOOGLE_MAPS_API_KEY
# Planned map vendors (not used — Google is primary)
# VITE_MAPBOX_ACCESS_TOKEN=

####################################
SENTRY (frontend — optional; requires @sentry/react)
####################################
VITE_SENTRY_DSN=YOUR_VITE_SENTRY_DSN

####################################
ANALYTICS / CAPTCHA (planned frontend keys)
####################################
# VITE_GA_MEASUREMENT_ID=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=
# VITE_PLAUSIBLE_DOMAIN=
# VITE_RECAPTCHA_SITE_KEY=
# VITE_TURNSTILE_SITE_KEY=

####################################
MEDIA
####################################
# VITE_MEDIA_BASE_URL=

####################################
APP DOWNLOAD REMINDER (mobile web only)
# Leave store URLs empty until listings are live — prompt shows "Coming Soon".
####################################
VITE_APP_DOWNLOAD_PROMPT_ENABLED=true
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
# Optional aliases:
# VITE_ANDROID_STORE_URL=
# VITE_IOS_STORE_URL=
VITE_APP_DOWNLOAD_DEEP_LINK=fixnow://
# Bump to re-allow "Don't show again" after a major release
VITE_APP_RELEASE_VERSION=1.0.0

####################################
CAPACITOR
# Live-reload WebView against Vite. Never set for release builds.
####################################
# CAP_SERVER_URL=YOUR_CAP_SERVER_URL

####################################
NATIVE ARTIFACTS (not Vite env)
# android/app/google-services.json  — Firebase / FCM for Android
# android/keystore.properties       — release signing (see .example)
####################################
