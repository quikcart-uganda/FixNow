{
  "name": "fixnow-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-frontend.mjs",
    "dev:vite": "vite",
    "customer": "node scripts/dev-frontend.mjs",
    "technician": "node scripts/dev-frontend.mjs",
    "admin": "node scripts/dev-frontend.mjs",
    "mobile": "node scripts/dev-frontend.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "node scripts/run-unit-tests.mjs all",
    "test:unit": "node scripts/run-unit-tests.mjs unit",
    "test:component": "node scripts/run-unit-tests.mjs component",
    "test:smoke": "npm --prefix backend run test:smoke",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:auth": "npm --prefix backend run test:auth",
    "test:payments": "npm --prefix backend run test:payments",
    "test:messaging": "npm --prefix backend run test:messaging",
    "test:sockets": "npm --prefix backend run test:sockets",
    "test:regression": "npm --prefix backend run test:regression",
    "test:regression:live": "npm --prefix backend run test:regression:live",
    "test:quality": "npm run typecheck && npm run lint && npm run test && npm run parity:android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run build && npx cap sync android && npx cap run android",
    "cap:run:ios": "npm run build && npx cap sync ios && npx cap run ios",
    "mobile:android": "npm run build && npx cap sync android && npx cap open android",
    "mobile:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "mobile:sync": "npm run build && npx cap sync",
    "android:validate": "node scripts/android-validate.mjs",
    "android:validate:strict": "node scripts/android-validate.mjs --strict",
    "android:assemble": "node scripts/android-assemble.mjs",
    "android:lan": "node scripts/android-lan-host.mjs",
    "android:lan:write": "node scripts/android-lan-host.mjs --write",
    "assets:generate": "node scripts/write-brand-masters.mjs && node scripts/prepare-brand-sources.mjs && capacitor-assets generate --assetPath resources --pwaManifestPath public/manifest.webmanifest --pwaNoAppleFetch true && node scripts/finalize-brand-assets.mjs",
    "assets:verify": "node scripts/verify-brand-assets.mjs",
    "parity:android": "node scripts/web-android-parity.mjs",
    "parity:web-android": "node scripts/check-web-android-parity.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "material-symbols": "^0.45.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
