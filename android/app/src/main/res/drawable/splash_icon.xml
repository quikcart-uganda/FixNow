<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ SplashScreen API icon.
  Blue rounded-square + white FixNow wrench at 58% occupancy (master brand geometry).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#004AC6" />
            <corners android:radius="28dp" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_fixnow_mark"
        android:gravity="center"
        android:width="63dp"
        android:height="63dp" />
</layer-list>
