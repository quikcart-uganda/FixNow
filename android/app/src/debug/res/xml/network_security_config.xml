<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds only (src/debug overlays src/main).
  Allows cleartext HTTP so the Capacitor WebView can reach a local FixNow
  API on the emulator (10.0.2.2) or a LAN machine. Release APKs keep the
  main/ cleartext=false policy and never load this file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
